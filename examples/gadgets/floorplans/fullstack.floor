# wires: bits, never ions
wire prep.syn -> decoder.syn latency 5 via 17.85 88, 2 88 as wire_prep_syn
wire clinic.syn -> decoder.syn latency 5 via 34.85 88, 2 88 as wire_clinic_syn
wire bench1.syn -> decoder.syn latency 5 via 58.15 88, 2 88 as wire_bench1_syn
wire bench1.res -> archive.in latency 5 via 65.4 88, 24 88 as wire_bench1_res
wire archive.ctl -> bench1.ctl latency 2 via 33 88, 72.65 88 as wire_bench1_ctl
wire post1.syn -> decoder.syn latency 5 via 84.75 88, 2 88 as wire_post1_syn
wire post1.res -> archive.in latency 5 via 86 88, 24 88 as wire_post1_res
wire archive.ctl -> post1.ctl latency 2 via 33 88, 87.25 88 as wire_post1_ctl
