# The full-stack machine: a gadget town that runs a FormalRV program (qccd/fullstack/machine.py).
# Generated by the town's own layout -- rows of places between streets, every door on a road --
# and judged by the floorplan rules F1-F9 like any other.
#
#   compute  two Pauli-product benches (ppm_d3): every PPM of the program, any product of one
#            X-bar or Z-bar from up to three blocks; a preparation place, a syndrome clinic and
#            two readouts
#   factory  two pharmacies (inj_d3): the |Y> blocks a pi/4 rotation consumes
#   memory   five memories: a block waiting between measurements rests corrected
#   supply   two depots
#   control  the decoder and the classical memory, wired to every door that carries bits

floorplan fullstack_d3 "A machine for FormalRV programs (surface code, d = 3)"
code surface_d3

region supply
place depot1    depot9  at 0 11
place depot2    depot9  at 51 63

region compute
place prep      prep_d3 at 14 10
place clinic    se_d3   at 31 10
place bench1    ppm_d3  at 48 10
place post1     read_d3 at 75 10
place bench2    ppm_d3  at 34 36
place post2     read_d3 at 78 36

region memory
place mem1      mem_d3  at 86 10
place mem2      mem_d3  at 17 36
place mem3      mem_d3  at 61 36
place mem4      mem_d3  at 17 62
place mem5      mem_d3  at 34 62

region factory
place pharmacy1 inj_d3  at 0 36
place pharmacy2 inj_d3  at 0 62

region control
place decoder   dec_d3  at 2 98
place archive   arch1   at 24 98

# junctions: where roads meet
junction j0_0 at 0 0
junction j0_1 at 8 0
junction j0_2 at 14 0
junction j0_3 at 25 0
junction j0_4 at 31 0
junction j0_5 at 42 0
junction j0_6 at 48 0
junction j0_7 at 52 0
junction j0_8 at 56 0
junction j0_9 at 61 0
junction j0_10 at 65 0
junction j0_11 at 69 0
junction j0_12 at 75 0
junction j0_13 at 80 0
junction j0_14 at 86 0
junction j0_15 at 97 0
junction w0 at -6 0
junction e0 at 103 0
junction j1_0 at 0 26
junction j1_1 at 11 26
junction j1_2 at 17 26
junction j1_3 at 28 26
junction j1_4 at 34 26
junction j1_5 at 38 26
junction j1_6 at 42 26
junction j1_7 at 47 26
junction j1_8 at 51 26
junction j1_9 at 55 26
junction j1_10 at 61 26
junction j1_11 at 72 26
junction j1_12 at 78 26
junction j1_13 at 83 26
junction w1 at -6 26
junction e1 at 103 26
junction j2_0 at 0 52
junction j2_1 at 11 52
junction j2_2 at 17 52
junction j2_3 at 28 52
junction j2_4 at 34 52
junction j2_5 at 45 52
junction j2_6 at 51 52
junction j2_7 at 59 52
junction w2 at -6 52
junction e2 at 103 52
junction j3_0 at 0 78
junction w3 at -6 78
junction e3 at 103 78

# roads: conveyors between doors and junction arms
road j0_0.s -- depot1.out as door_depot1_out
road j0_1.s -- depot1.in as door_depot1_in
road j0_2.s -- prep.in as door_prep_in
road j0_3.s -- prep.out as door_prep_out
road j0_4.s -- clinic.in as door_clinic_in
road j0_5.s -- clinic.out as door_clinic_out
road j0_6.s -- bench1.in_a as door_bench1_in_a
road j0_7.s -- bench1.in_b as door_bench1_in_b
road j0_8.s -- bench1.in_c as door_bench1_in_c
road j0_9.s -- bench1.out_c as door_bench1_out_c
road j0_10.s -- bench1.out_b as door_bench1_out_b
road j0_11.s -- bench1.out_a as door_bench1_out_a
road j0_12.s -- post1.in as door_post1_in
road j0_13.s -- post1.out as door_post1_out
road j0_14.s -- mem1.in as door_mem1_in
road j0_15.s -- mem1.out as door_mem1_out
road w0.e -- j0_0.w as street0_w0_j0_0
road j0_0.e -- j0_1.w as street0_j0_0_j0_1
road j0_1.e -- j0_2.w as street0_j0_1_j0_2
road j0_2.e -- j0_3.w as street0_j0_2_j0_3
road j0_3.e -- j0_4.w as street0_j0_3_j0_4
road j0_4.e -- j0_5.w as street0_j0_4_j0_5
road j0_5.e -- j0_6.w as street0_j0_5_j0_6
road j0_6.e -- j0_7.w as street0_j0_6_j0_7
road j0_7.e -- j0_8.w as street0_j0_7_j0_8
road j0_8.e -- j0_9.w as street0_j0_8_j0_9
road j0_9.e -- j0_10.w as street0_j0_9_j0_10
road j0_10.e -- j0_11.w as street0_j0_10_j0_11
road j0_11.e -- j0_12.w as street0_j0_11_j0_12
road j0_12.e -- j0_13.w as street0_j0_12_j0_13
road j0_13.e -- j0_14.w as street0_j0_13_j0_14
road j0_14.e -- j0_15.w as street0_j0_14_j0_15
road j0_15.e -- e0.w as street0_j0_15_e0
road j1_0.s -- pharmacy1.in as door_pharmacy1_in
road j1_1.s -- pharmacy1.out as door_pharmacy1_out
road j1_2.s -- mem2.in as door_mem2_in
road j1_3.s -- mem2.out as door_mem2_out
road j1_4.s -- bench2.in_a as door_bench2_in_a
road j1_5.s -- bench2.in_b as door_bench2_in_b
road j1_6.s -- bench2.in_c as door_bench2_in_c
road j1_7.s -- bench2.out_c as door_bench2_out_c
road j1_8.s -- bench2.out_b as door_bench2_out_b
road j1_9.s -- bench2.out_a as door_bench2_out_a
road j1_10.s -- mem3.in as door_mem3_in
road j1_11.s -- mem3.out as door_mem3_out
road j1_12.s -- post2.in as door_post2_in
road j1_13.s -- post2.out as door_post2_out
road w1.e -- j1_0.w as street1_w1_j1_0
road j1_0.e -- j1_1.w as street1_j1_0_j1_1
road j1_1.e -- j1_2.w as street1_j1_1_j1_2
road j1_2.e -- j1_3.w as street1_j1_2_j1_3
road j1_3.e -- j1_4.w as street1_j1_3_j1_4
road j1_4.e -- j1_5.w as street1_j1_4_j1_5
road j1_5.e -- j1_6.w as street1_j1_5_j1_6
road j1_6.e -- j1_7.w as street1_j1_6_j1_7
road j1_7.e -- j1_8.w as street1_j1_7_j1_8
road j1_8.e -- j1_9.w as street1_j1_8_j1_9
road j1_9.e -- j1_10.w as street1_j1_9_j1_10
road j1_10.e -- j1_11.w as street1_j1_10_j1_11
road j1_11.e -- j1_12.w as street1_j1_11_j1_12
road j1_12.e -- j1_13.w as street1_j1_12_j1_13
road j1_13.e -- e1.w as street1_j1_13_e1
road j2_0.n -- pharmacy1.magic as door_pharmacy1_magic
road j2_0.s -- pharmacy2.in as door_pharmacy2_in
road j2_1.s -- pharmacy2.out as door_pharmacy2_out
road j2_2.s -- mem4.in as door_mem4_in
road j2_3.s -- mem4.out as door_mem4_out
road j2_4.s -- mem5.in as door_mem5_in
road j2_5.s -- mem5.out as door_mem5_out
road j2_6.s -- depot2.out as door_depot2_out
road j2_7.s -- depot2.in as door_depot2_in
road w2.e -- j2_0.w as street2_w2_j2_0
road j2_0.e -- j2_1.w as street2_j2_0_j2_1
road j2_1.e -- j2_2.w as street2_j2_1_j2_2
road j2_2.e -- j2_3.w as street2_j2_2_j2_3
road j2_3.e -- j2_4.w as street2_j2_3_j2_4
road j2_4.e -- j2_5.w as street2_j2_4_j2_5
road j2_5.e -- j2_6.w as street2_j2_5_j2_6
road j2_6.e -- j2_7.w as street2_j2_6_j2_7
road j2_7.e -- e2.w as street2_j2_7_e2
road j3_0.n -- pharmacy2.magic as door_pharmacy2_magic
road w3.e -- j3_0.w as street3_w3_j3_0
road j3_0.e -- e3.w as street3_j3_0_e3
road w0.s -- w1.n as west_0
road e0.s -- e1.n as east_0
road w1.s -- w2.n as west_1
road e1.s -- e2.n as east_1
road w2.s -- w3.n as west_2
road e2.s -- e3.n as east_2

# wires: bits, never ions
wire prep.syn -> decoder.syn latency 5 via 17.85 88, 2 88 as wire_prep_syn
wire clinic.syn -> decoder.syn latency 5 via 34.85 88, 2 88 as wire_clinic_syn
wire bench1.syn -> decoder.syn latency 5 via 55.35 88, 2 88 as wire_bench1_syn
wire bench1.res -> archive.in latency 5 via 60.6 88, 24 88 as wire_bench1_res
wire archive.ctl -> bench1.ctl latency 2 via 33 88, 65.85 88 as wire_bench1_ctl
wire post1.syn -> decoder.syn latency 5 via 76.75 88, 2 88 as wire_post1_syn
wire post1.res -> archive.in latency 5 via 78 88, 24 88 as wire_post1_res
wire archive.ctl -> post1.ctl latency 2 via 33 88, 79.25 88 as wire_post1_ctl
wire mem1.syn -> decoder.syn latency 5 via 89.85 88, 2 88 as wire_mem1_syn
wire pharmacy1.syn -> decoder.syn latency 5 via 3.85 88, 2 88 as wire_pharmacy1_syn
wire archive.ctl -> pharmacy1.ctl latency 2 via 33 88, 9.35 88 as wire_pharmacy1_ctl
wire mem2.syn -> decoder.syn latency 5 via 20.85 88, 2 88 as wire_mem2_syn
wire bench2.syn -> decoder.syn latency 5 via 41.35 88, 2 88 as wire_bench2_syn
wire bench2.res -> archive.in latency 5 via 46.6 88, 24 88 as wire_bench2_res
wire archive.ctl -> bench2.ctl latency 2 via 33 88, 51.85 88 as wire_bench2_ctl
wire mem3.syn -> decoder.syn latency 5 via 64.85 88, 2 88 as wire_mem3_syn
wire post2.syn -> decoder.syn latency 5 via 79.75 88, 2 88 as wire_post2_syn
wire post2.res -> archive.in latency 5 via 81 88, 24 88 as wire_post2_res
wire archive.ctl -> post2.ctl latency 2 via 33 88, 82.25 88 as wire_post2_ctl
wire pharmacy2.syn -> decoder.syn latency 5 via 3.85 88, 2 88 as wire_pharmacy2_syn
wire archive.ctl -> pharmacy2.ctl latency 2 via 33 88, 9.35 88 as wire_pharmacy2_ctl
wire mem4.syn -> decoder.syn latency 5 via 20.85 88, 2 88 as wire_mem4_syn
wire mem5.syn -> decoder.syn latency 5 via 37.85 88, 2 88 as wire_mem5_syn
wire decoder.frame -> archive.frame latency 1 as wire_decoder_frame
