road j1_0.s -- pharmacy1.in as door_pharmacy1_in
road j1_1.s -- pharmacy1.out as door_pharmacy1_out
road j1_2.s -- factory1.out as door_factory1_out
road j1_3.s -- mem3.in as door_mem3_in
