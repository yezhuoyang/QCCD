wire mem2.syn -> decoder.syn latency 5 via 114.85 88, 2 88 as wire_mem2_syn
wire pharmacy1.syn -> decoder.syn latency 5 via 3.85 88, 2 88 as wire_pharmacy1_syn
wire archive.ctl -> pharmacy1.ctl latency 2 via 33 88, 9.35 88 as wire_pharmacy1_ctl
