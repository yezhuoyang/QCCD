# A wider full-stack machine (qccd/fullstack/machine.py, wide_rows): the same places as the
# full-stack machine, more of them -- 4 Pauli-product benches, 4 factories each
# beside a pharmacy, 32 memories (one for every block a program keeps alive across its
# gadgets) -- in rows of 9 between streets, judged by F1-F9 like any other.

floorplan fullstack_wide_d3 "A wide machine for FormalRV programs (surface code, d = 3, 32 memories)"
code surface_d3

region supply
place depot1    depot9  at 0 11
place depot2    depot9  at 85 141

region compute
place prep      prep_d3 at 14 10
place clinic    se_d3   at 31 10
place bench1    ppm_d3  at 108 36
place bench2    ppm_d3  at 143 36
place bench3    ppm_d3  at 178 36
place bench4    ppm_d3  at 213 36
place post1     read_d3 at 248 36
place post2     read_d3 at 259 36

region memory
place zone1     zone_d3 at 270 36
place mem1      mem_d3  at 1 62
place mem2      mem_d3  at 18 62
place mem3      mem_d3  at 35 62
place mem4      mem_d3  at 52 62
place mem5      mem_d3  at 69 62
place mem6      mem_d3  at 86 62
place mem7      mem_d3  at 103 62
place mem8      mem_d3  at 120 62
place mem9      mem_d3  at 137 62
place mem10     mem_d3  at 0 88
place mem11     mem_d3  at 17 88
place mem12     mem_d3  at 34 88
