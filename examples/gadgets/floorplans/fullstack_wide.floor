place mem23     mem_d3  at 68 114
place mem24     mem_d3  at 85 114
place mem25     mem_d3  at 102 114
place mem26     mem_d3  at 119 114
place mem27     mem_d3  at 136 114
place mem28     mem_d3  at 0 140
place mem29     mem_d3  at 17 140
place mem30     mem_d3  at 34 140
place mem31     mem_d3  at 51 140
place mem32     mem_d3  at 68 140

region factory
place pharmacy1 inj_d3  at 48 10
place factory1  msf15   at 65 10
place pharmacy2 inj_d3  at 80 10
place factory2  msf15   at 97 10
place pharmacy3 inj_d3  at 112 10
place factory3  msf15   at 129 10
place pharmacy4 inj_d3  at 76 36
place factory4  msf15   at 93 36

region control
place decoder   dec_d3  at 2 176
place archive   arch1   at 24 176

