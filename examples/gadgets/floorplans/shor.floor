# A machine for Shor's algorithm (the program shor15): the order of 7
# modulo 15, fault-tolerant, every logical qubit a d = 3 surface-code block.
#
# What the program needs at once decided what is here:
#   memory   six memories (mem_d3): the four work blocks and a control block rest for
#            seconds between iterations, and a memory corrects a resting block in place --
#            the town's three passive zones could neither hold them all nor keep them alive
#            past the one-second budget (G8)
#   compute  three lattice-surgery bridges: every T gate and every S-bar / sqrt-X-bar gadget
#            is a surgery (44 of them), the busiest resource by far; one workshop for the
#            22 transversal CNOTs; two readouts; one preparation place
#   factory  two factories, each beside a pharmacy: 15 magic states, made while the
#            computation runs
#   supply   two depots, one for the compute rows and one beside the factories
#   control  the decoder and the classical memory, wired to every door that carries bits
#
# Laid out in three rows between four streets, like the town; Shor's algorithm names this
# floorplan (floorplan "shor"), and the floorplan rules F1-F9 hold on it.

floorplan shor_d3 "A machine for Shor's algorithm (surface code, d = 3)"
code surface_d3

region supply
place depot1    depot9  at 0 11
place depot2    depot9  at 27 63

region compute
place prep      prep_d3 at 14 10
place workshop  tcx_d3  at 48 11
place post1     read_d3 at 62 10
place bridge1   ls_d3   at 27 36
place bridge2   ls_d3   at 79 36
place post2     read_d3 at 114 36
place bridge3   ls_d3   at 139 62

region memory
place mem1      mem_d3  at 31 10
place mem2      mem_d3  at 73 10
place mem3      mem_d3  at 90 10
place mem4      mem_d3  at 62 36
place mem5      mem_d3  at 73 62
place mem6      mem_d3  at 90 62

region factory
place factory1  msf15   at 41 62
place pharmacy1 inj_d3  at 56 62
place factory2  msf15   at 107 62
place pharmacy2 inj_d3  at 122 62

region control
place decoder   dec_d3  at 2 98
place archive   arch1   at 24 98

# junctions: where roads meet
junction j0_0 at 0 0
junction j0_1 at 8 0
junction j0_2 at 14 0
junction j0_3 at 25 0
junction j0_4 at 31 0
junction j0_5 at 42 0
junction j0_6 at 48 0
junction j0_7 at 56 0
junction j0_8 at 62 0
junction j0_9 at 67 0
junction j0_10 at 73 0
junction j0_11 at 84 0
junction j0_12 at 90 0
junction j0_13 at 101 0
junction w0 at -6 0
junction e0 at 174 0
junction j1_0 at 27 26
junction j1_1 at 48 26
junction j1_2 at 56 26
junction j1_3 at 62 26
junction j1_4 at 73 26
junction j1_5 at 79 26
junction j1_6 at 108 26
junction j1_7 at 114 26
junction j1_8 at 119 26
junction w1 at -6 26
junction e1 at 174 26
junction j2_0 at 27 52
junction j2_1 at 35 52
junction j2_2 at 50 52
junction j2_3 at 56 52
junction j2_4 at 67 52
junction j2_5 at 73 52
junction j2_6 at 79 52
junction j2_7 at 84 52
junction j2_8 at 90 52
junction j2_9 at 101 52
junction j2_10 at 108 52
junction j2_11 at 116 52
junction j2_12 at 122 52
junction j2_13 at 133 52
junction j2_14 at 139 52
junction j2_15 at 168 52
junction w2 at -6 52
junction e2 at 174 52
junction j3_0 at 41 78
junction j3_1 at 56 78
junction j3_2 at 107 78
junction j3_3 at 122 78
junction j3_4 at 139 78
junction j3_5 at 168 78
junction w3 at -6 78
junction e3 at 174 78

# roads: conveyors between doors and junction arms
road j0_0.s -- depot1.out as door_depot1_out
road j0_1.s -- depot1.in as door_depot1_in
road j0_2.s -- prep.in as door_prep_in
road j0_3.s -- prep.out as door_prep_out
road j0_4.s -- mem1.in as door_mem1_in
road j0_5.s -- mem1.out as door_mem1_out
road j0_6.s -- workshop.a_in as door_workshop_a_in
road j0_7.s -- workshop.a_out as door_workshop_a_out
road j0_8.s -- post1.in as door_post1_in
road j0_9.s -- post1.out as door_post1_out
road j0_10.s -- mem2.in as door_mem2_in
road j0_11.s -- mem2.out as door_mem2_out
road j0_12.s -- mem3.in as door_mem3_in
road j0_13.s -- mem3.out as door_mem3_out
road w0.e -- j0_0.w as street0_w0_j0_0
road j0_0.e -- j0_1.w as street0_j0_0_j0_1
road j0_1.e -- j0_2.w as street0_j0_1_j0_2
road j0_2.e -- j0_3.w as street0_j0_2_j0_3
road j0_3.e -- j0_4.w as street0_j0_3_j0_4
road j0_4.e -- j0_5.w as street0_j0_4_j0_5
