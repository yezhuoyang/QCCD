road j2_0.e -- j2_1.w as street2_j2_0_j2_1
road j2_1.e -- j2_2.w as street2_j2_1_j2_2
road j2_2.e -- j2_3.w as street2_j2_2_j2_3
road j2_3.e -- j2_4.w as street2_j2_3_j2_4
road j2_4.e -- j2_5.w as street2_j2_4_j2_5
road j2_5.e -- j2_6.w as street2_j2_5_j2_6
road j2_6.e -- j2_7.w as street2_j2_6_j2_7
road j2_7.e -- j2_8.w as street2_j2_7_j2_8
road j2_8.e -- j2_9.w as street2_j2_8_j2_9
road j2_9.e -- j2_10.w as street2_j2_9_j2_10
road j2_10.e -- j2_11.w as street2_j2_10_j2_11
road j2_11.e -- j2_12.w as street2_j2_11_j2_12
road j2_12.e -- j2_13.w as street2_j2_12_j2_13
road j2_13.e -- j2_14.w as street2_j2_13_j2_14
road j2_14.e -- j2_15.w as street2_j2_14_j2_15
road j2_15.e -- e2.w as street2_j2_15_e2
road j3_0.n -- factory1.in as door_factory1_in
road j3_1.n -- pharmacy1.magic as door_pharmacy1_magic
road j3_2.n -- factory2.in as door_factory2_in
road j3_3.n -- pharmacy2.magic as door_pharmacy2_magic
road j3_4.n -- bridge3.in_b as door_bridge3_in_b
road j3_5.n -- bridge3.out_b as door_bridge3_out_b
road w3.e -- j3_0.w as street3_w3_j3_0
road j3_0.e -- j3_1.w as street3_j3_0_j3_1
