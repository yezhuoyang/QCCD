road j0_8.e -- j0_9.w as street0_j0_8_j0_9
road j0_9.e -- j0_10.w as street0_j0_9_j0_10
road j0_10.e -- j0_11.w as street0_j0_10_j0_11
road j0_11.e -- j0_12.w as street0_j0_11_j0_12
road j0_12.e -- j0_13.w as street0_j0_12_j0_13
road j0_13.e -- e0.w as street0_j0_13_e0
road j1_0.s -- bridge1.in_a as door_bridge1_in_a
road j1_1.n -- workshop.b_in as door_workshop_b_in
road j1_2.n -- workshop.b_out as door_workshop_b_out
road j1_2.s -- bridge1.out_a as door_bridge1_out_a
road j1_3.s -- mem4.in as door_mem4_in
road j1_4.s -- mem4.out as door_mem4_out
road j1_5.s -- bridge2.in_a as door_bridge2_in_a
road j1_6.s -- bridge2.out_a as door_bridge2_out_a
road j1_7.s -- post2.in as door_post2_in
road j1_8.s -- post2.out as door_post2_out
road w1.e -- j1_0.w as street1_w1_j1_0
road j1_0.e -- j1_1.w as street1_j1_0_j1_1
road j1_1.e -- j1_2.w as street1_j1_1_j1_2
road j1_2.e -- j1_3.w as street1_j1_2_j1_3
road j1_3.e -- j1_4.w as street1_j1_3_j1_4
road j1_4.e -- j1_5.w as street1_j1_4_j1_5
road j1_5.e -- j1_6.w as street1_j1_5_j1_6
road j1_6.e -- j1_7.w as street1_j1_6_j1_7
road j1_7.e -- j1_8.w as street1_j1_7_j1_8
road j1_8.e -- e1.w as street1_j1_8_e1
road j2_0.n -- bridge1.in_b as door_bridge1_in_b
road j2_0.s -- depot2.out as door_depot2_out
road j2_1.s -- depot2.in as door_depot2_in
road j2_2.s -- factory1.out as door_factory1_out
road j2_3.n -- bridge1.out_b as door_bridge1_out_b
road j2_3.s -- pharmacy1.in as door_pharmacy1_in
road j2_4.s -- pharmacy1.out as door_pharmacy1_out
road j2_5.s -- mem5.in as door_mem5_in
road j2_6.n -- bridge2.in_b as door_bridge2_in_b
road j2_7.s -- mem5.out as door_mem5_out
road j2_8.s -- mem6.in as door_mem6_in
road j2_9.s -- mem6.out as door_mem6_out
road j2_10.n -- bridge2.out_b as door_bridge2_out_b
road j2_11.s -- factory2.out as door_factory2_out
road j2_12.s -- pharmacy2.in as door_pharmacy2_in
road j2_13.s -- pharmacy2.out as door_pharmacy2_out
