  "heating": {
    "anomalous_rate_quanta_per_ms": 0.05,
    "note": "R17: ndot = S_E(w) e^2 / 4 m hbar w, accruing whether or not the ion moves. Device-specific and unmeasured for the target trap -- q_heating_rate_measurement",
    "source": "2605.25118"
  },
  "species": {
    "qubit": "Ba+",
    "coolant": "Sr+",
    "sympathetic": true,
    "coolant_fraction": 0.5,
    "T_coh_s": 600,
    "source": "2510.23519"
  },
  "budget": {
    "max_dacs": 128,
    "max_junctions": 200,
    "max_area_mm2": 100,
    "junction_electrode_multiplier": 2
  },
  "geometry": {
    "generator": "racetrack",
    "params": {
      "straight": 20
    }
  },
  "control": {
    "model": "simd_classes",
    "classes": {
      "generator": "x_junction_grid",
      "count": 18,
      "note": "12 directional shifts + 6 directional swaps (JT-SIMD, 2504.17886)",
      "extra": [
        {
          "id": "rotate_cw",
          "type": "shift",
          "orbit": "L0",
          "delta": 1
        },
        {
          "id": "rotate_ccw",
          "type": "shift",
          "orbit": "L0",
          "delta": -1
        },
        {
          "id": "sort_merge",
          "type": "shift",
          "orbit": "L0",
          "delta": -1,
          "entails": [
            "merge"
          ],
          "note": "one ion of the pair joins the neighbouring chain"
        },
        {
          "id": "sort_split",
          "type": "shift",
          "orbit": "L0",
          "delta": 1,
          "entails": [
            "split"
          ],
          "note": "the other splits back out; which one realizes the transposition"
        },
        {
          "id": "shuttle",
          "type": "shift",
          "orbit": "any",
          "note": "one ion, one trap to the next; the lowest common denominator move"
        }
      ]
    },
    "max_simd_classes_per_cycle": 1,
    "intra_inter_exclusive": true,
    "wiring": {
      "scheme": "broadcast_groups",
      "dacs_dynamic": 3,
      "shim_per_dac": 1,
      "electrodes_per_trap": 3,
      "electrodes_per_junction": 0,
      "compensation_electrodes_per_trap": 1,
      "note": "conveyor-belt DC electrodes tied {a,b,c}: three signals drive 20 wells per side, with separate individually driven shims for micromotion compensation"
    },
    "optical": {
      "addressing": "global_beam",
      "per_zone_switch": true
    },
    "channels": {
      "grouping": "broadcast",
      "frame": "path",
      "frame_note": "the conveyor tiling FOLLOWS the trap axis: H2 is a single continuous RF null whose curved end zones are ordinary conveyor-belt regions driven by the same {a,b,c} broadcast tiling as the straights, so one waveform means 'forward one slot' at a bend too and the whole loop rotates on one channel (2305.03828). A machine whose electrodes are tiled on the chip axes declares frame='lab' instead and pays len(corners(L0)) = 4 channel groups for the same rotation (R19).",
      "roles": {
        "linear_h": 6,
        "linear_v": 6,
        "junction": 4
      },
      "differential": 2,
      "switch_per_site": true
    }
  }
}
