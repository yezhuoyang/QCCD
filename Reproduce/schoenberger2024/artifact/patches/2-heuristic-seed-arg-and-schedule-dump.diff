+# Added for the reproduction run (not part of the artifact): write the per-time-step records
+# collected by run_simulation(recorder=...) as JSON. Reads MemoryZone attributes only.
+import json
+
+import networkx as nx
+
+from graph_utils import get_idc_from_idx, get_idx_from_idc
+
+
+def _nid(nd):
+    return f"{nd[0]},{nd[1]}"
+
+
+def _eid(idx):
+    return f"e{idx}"
+
+
+def _through_nodes(graph, src, tar):
+    if set(src) == set(tar):
+        return []
+    common = set(src) & set(tar)
+    if len(common) == 1:
+        return [next(iter(common))]
+    best = None
+    for a in src:
+        for b in tar:
+            p = nx.shortest_path(graph, a, b)
+            if best is None or len(p) < len(best):
+                best = p
+    return best
+
+
+def dump_heuristic(rec, path, config, command, circuit_file, arch, pz, max_timesteps):
+    mg = rec["memorygrid"]
+    g = mg.graph
+    gc = mg.graph_creator
+    idc = mg.idc_dict
+    node_type = nx.get_node_attributes(g, "node_type")
+    pk = get_idx_from_idc(idc, gc.parking_edge)
+    junctionish = set(mg.junction_nodes) | {gc.processing_zone, gc.entry, gc.exit}
+
+    nodes = [
+        {"id": _nid(nd), "coord": [nd[0], nd[1]], "plot_xy": [nd[1], -nd[0]], "node_type": node_type[nd]}
+        for nd in g.nodes()
+    ]
+    edges = []
+    for idx in range(len(g.edges())):
+        e = get_idc_from_idx(idc, idx)
+        et = g.edges[e]["edge_type"]
+        edges.append(
+            {
+                "id": _eid(idx),
+                "idx": idx,
+                "nodes": [_nid(e[0]), _nid(e[1])],
+                "edge_type": et,
+                "capacity": mg.max_num_parking if idx == pk else 1,
+            }
+        )
+
+    init = {ion: get_idx_from_idc(idc, e) for ion, e in rec["ion_chains_initial"].items()}
+    steps = []
+    events = []
+    eid = 0
+    prev = init
+    for r in rec["records"]:
+        t = r["t"]
+        pos = r["positions"]
+        pre = r["positions_after_preprocess"]
+        moved = [ion for ion in pos if pos[ion] != prev[ion]]
+        moves = []
+        for ion in moved:
+            hops = []
+            if pre[ion] != prev[ion]:
+                hops.append(("preprocess", prev[ion], pre[ion]))
+            if pos[ion] != pre[ion]:
+                hops.append(("rotate", pre[ion], pos[ion]))
+            for phase, a, b in hops:
+                thr = _through_nodes(g, get_idc_from_idx(idc, a), get_idc_from_idx(idc, b))
+                moves.append(
+                    {
+                        "ion": ion,
+                        "phase": phase,
+                        "from": _eid(a),
+                        "to": _eid(b),
+                        "through_nodes": [_nid(nd) for nd in thr],
+                        "through_junction_like_nodes": [_nid(nd) for nd in thr if nd in junctionish],
+                    }
+                )
+                events.append({"id": eid, "kind": f"move/{phase}", "t0": t, "t1": t + 1, "ion": ion,
+                               "from": _eid(a), "to": _eid(b)})
+                eid += 1
+        gates = []
+        if r["gate_executing"]:
+            gates.append(list(r["gate_candidate"]))
+            events.append({"id": eid, "kind": "gate_step", "t0": t, "t1": t + 1, "qubits": list(r["gate_candidate"]),
+                           "op": r["gate_candidate_op"], "step_of_gate": r["time_in_pz_counter_before"] + 1,
+                           "duration": r["gate_duration"]})
+            eid += 1
+        steps.append(
+            {
+                "t": t,
+                "positions": {str(i): _eid(e) for i, e in pos.items()},
+                "gates": gates,
+                "gate_detail": (
+                    {
+                        "qubits": list(r["gate_candidate"]),
+                        "op": r["gate_candidate_op"],
+                        "step_of_gate": r["time_in_pz_counter_before"] + 1,
+                        "duration": r["gate_duration"],
+                        "completed_this_step": r["time_in_pz_counter_after"] == 0 or r["finished"],
+                    }
+                    if r["gate_executing"]
+                    else None
+                ),
+                "next_gate_waiting": None if r["gate_executing"] else list(r["gate_candidate"]),
+                "moved": moved,
+                "moves": moves,
+                "positions_after_preprocess": {str(i): _eid(e) for i, e in pre.items()},
+                "move_list": r["move_list"],
+                "rotated_circles": {str(k): [_eid(x) for x in v] for k, v in r["rotated_circles"].items()},
+                "blocked_circles": {str(k): [_eid(x) for x in v] for k, v in r["blocked_circles"].items()},
+                "rotate_entry": r["rotate_entry"],
+                "chain_to_move_out_of_pz": r["chain_to_move_out_of_pz"],
+            }
+        )
+        prev = pos
+
+    out = {
+        "tool": "MQT IonShuttler cycle heuristic (run_heuristic.py / scheduling.run_simulation)",
+        "repo": "https://github.com/munich-quantum-toolkit/ionshuttler",
+        "commit": "bc71e46796a1d8f221d608991089d0ba3f0b0b56",
+        "command": command,
+        "config": {
+            **config,
+            "seed": rec["seed"],
+            "pz": pz,
+            "max_timesteps": max_timesteps,
+            "time_1qubit_gate": mg.time_1qubit_gate,
+            "time_2qubit_gate": mg.time_2qubit_gate,
+            "max_chains_in_parking": mg.max_num_parking,
+            "compilation (Gate Selection)": True,
+            "max_length (priority queue)": 10,
+            "pz_path_edges (n // 2)": gc.num_edges,
+        },
+        "circuit_file": circuit_file,
+        "initial_sequence": [list(x) for x in rec["seq_initial"]],
+        "placement_rule": "create_starting_config: random.seed(seed); random.sample(range(n_of_traps), n_of_chains); ion i -> trap_edges[sample[i]]",
+        "time_units": "abstract time steps; step t = one iteration of run_simulation's while loop (preprocess slide, cycle rotation, then gate processing); printed number = index of the final iteration (0-based)",
+        "graph": {
+            "nodes": nodes,
+            "edges": edges,
+            "junction_nodes(MemoryZone.junction_nodes)": [_nid(nd) for nd in mg.junction_nodes],
+            "processing_zone_node": _nid(gc.processing_zone),
+            "parking_edge(gate site)": _eid(pk),
+            "memory_edges": [e["id"] for e in edges if e["edge_type"] == "trap"],
+            "path_to_pz(exit)": [_eid(i) for i in gc.path_to_pz_idxs],
+            "path_from_pz(entry)": [_eid(i) for i in gc.path_from_pz_idxs],
+            "node_id_format": "row,col of the networkx grid (row 0 at top; PZ path nodes have fractional coords)",
+        },
+        "initial": {str(i): _eid(e) for i, e in init.items()},
+        "initial_layout": {_eid(e): [str(i)] for i, e in init.items()},
+        "qubit_to_ion": {str(i): str(i) for i in init},
+        "steps": steps,
+        "events": events,
+        "metrics": {
+            "Circuit successfully executed in N time steps": rec["printed_timestep"],
+            "CPU time (s)": rec.get("cpu_time"),
+            "iterations_run": len(rec["records"]),
+        },
+    }
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(out, f, indent=1)
