evaluation "goal1"
title "Goal 1: the best QEC memory under 200 ions"
about "Every curated memory experiment under 200 ions, compiled for a design, run under qccd-noise@2 on the cited Helios-class physics, and ranked by its logical error rate per round per logical qubit."
include "board"
include "qccd-noise@2"
clock "quantinuum"
rules "standard"
rank ler_per_round_per_logical

# the release's budget: its fixed physics, which a design may not change
param max_dacs = 128
param max_junctions = 200
param max_ions = 200

require G1 "Every rule of the standard rule set holds"
  about "The programme is judged by the Rules page's standard set, rule by rule."
  rules_hold()

require G2 "No more than 200 ions"
  about "The board's own filter: an entry over it is graded, and not listed."
  n_ions <= max_ions

require G3 "With its noise taken out, the circuit is the experiment"
  about "Every detector and every logical observable has a fixed value, and it is 0: the value the experiment's own circuit gives it."
  noiseless_ok()
