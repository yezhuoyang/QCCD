init q0@S,q1@G;
simd transport q0:S->G[p0];
idle 1;
idle 1;
idle 1;
pulse R((pi/7),((pi/2)-0)) q0 @G via c0;
pulse R(pi,0) q0 @G via c1;
pulse R(pi,((0+0)/2)) q0 @G via c2;
pulse R((pi/2),(pi/2)) q0 @G via c3;
pulse MS((pi/2)) q0,q1 @G via c4;
broadcast R((-(pi/2)),0) q0@G, R((-(pi/2)),0) q1@G via b0;
pulse R((-(pi/2)),(pi/2)) q0 @G via c6;
readout q0 -> c0 @G via a0;
latch saved <- little_endian(c0,c1) == 1;
when saved pulse R((pi/2),(pi/2)) q0 @G via c3;
when saved pulse MS((pi/2)) q0,q1 @G via c4;
when saved broadcast R((-(pi/2)),0) q0@G, R((-(pi/2)),0) q1@G via b0;
when saved pulse R((-(pi/2)),(pi/2)) q0 @G via c6;
latch saved <- little_endian(c0,c1) == 1;
when saved readout q0 -> c0 @G via a0;
when saved readout q1 -> c1 @G via a0;
pump q0 @G via p0;
latch saved <- little_endian(c0,c1) == 1;
when saved pump q1 @G via p0;
barrier q0,q1;
