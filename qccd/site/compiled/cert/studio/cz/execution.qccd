init q0@T0_0h,q1@T0_1h;
pulse R((pi/2),((pi/2)-pi)) q1 @T0_1h via c7;
pulse R(pi,0) q1 @T0_1h via c8;
pulse R(pi,((0+pi)/2)) q1 @T0_1h via c9;
pulse R((pi/2),(pi/2)) q0 @T0_0h via c3;
simd transport q0:T0_0h->T1_0v[p0];
simd transport q0:T1_0v->T0_1h[p14];
pulse MS((pi/2)) q0,q1 @T0_1h via c11;
pulse R((-(pi/2)),0) q0 @T0_1h via c12;
pulse R((-(pi/2)),0) q1 @T0_1h via c12;
pulse R((-(pi/2)),(pi/2)) q0 @T0_1h via c13;
pulse R((pi/2),((pi/2)-pi)) q1 @T0_1h via c7;
pulse R(pi,0) q1 @T0_1h via c8;
pulse R(pi,((0+pi)/2)) q1 @T0_1h via c9;
