init q0@A0,q1@A3,q2@S1,q3@S2;
pulse R((pi/2),((pi/2)-pi)) q0 @A0 via c0;
pulse R(pi,0) q0 @A0 via c1;
pulse R(pi,((0+pi)/2)) q0 @A0 via c2;
pulse R((pi/2),(pi/2)) q0 @A0 via c3;
simd transport q1:A3->S2[p14];
simd transport q1:S2->S1[p3];
simd transport q1:S1->A0[p2];
pulse MS((pi/2)) q0,q1 @A0 via c4;
pulse R((-(pi/2)),0) q0 @A0 via c5;
pulse R((-(pi/2)),0) q1 @A0 via c5;
pulse R((-(pi/2)),(pi/2)) q0 @A0 via c6;
pulse R((pi/2),(pi/2)) q1 @A0 via c3;
simd transport q0:A0->S1[p12];
simd transport q2:S1->A0[p2];
pulse MS((pi/2)) q1,q2 @A0 via c4;
pulse R((-(pi/2)),0) q1 @A0 via c5;
pulse R((-(pi/2)),0) q2 @A0 via c5;
pulse R((-(pi/2)),(pi/2)) q1 @A0 via c6;
pulse R((pi/2),(pi/2)) q2 @A0 via c3;
simd transport q1:A0->S1[p12];
simd transport q3:S2->S4[p4];
simd transport q3:S4->S5[p6];
simd transport q3:S5->A0[p11];
pulse MS((pi/2)) q2,q3 @A0 via c4;
pulse R((-(pi/2)),0) q2 @A0 via c5;
pulse R((-(pi/2)),0) q3 @A0 via c5;
pulse R((-(pi/2)),(pi/2)) q2 @A0 via c6;
simd transport q2:A0->S5[p13];
simd transport q0:S1->A0[p2];
readout q0 -> c0 @A0 via a0;
simd transport q0:A0->S1[p12];
simd transport q1:S1->A0[p2];
readout q1 -> c1 @A0 via a0;
simd transport q1:A0->S1[p12];
simd transport q2:S5->A0[p11];
readout q2 -> c2 @A0 via a0;
readout q3 -> c3 @A0 via a0;
