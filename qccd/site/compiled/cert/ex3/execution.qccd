init q0@C0,q1@C1,q2@C2,q3@C3;
pulse R((pi/2),(pi/2)) q0 @C0 via c0;
simd transport q0:C0->C1[p0];
pulse MS((pi/2)) q0,q1 @C1 via c5;
broadcast R((-(pi/2)),0) q0@C1, R((-(pi/2)),0) q1@C1 via b1;
pulse R((-(pi/2)),(pi/2)) q0 @C1 via c7;
pulse R((pi/2),(pi/2)) q2 @C2 via c8;
simd transport q2:C2->C3[p2];
pulse MS((pi/2)) q2,q3 @C3 via c13;
broadcast R((-(pi/2)),0) q2@C3, R((-(pi/2)),0) q3@C3 via b3;
pulse R((-(pi/2)),(pi/2)) q2 @C3 via c15;
pulse R((pi/2),(pi/2)) q0 @C1 via c4;
simd transport q0:C1->C2[p1];
simd transport q3:C3->C2[p5];
pulse MS((pi/2)) q0,q3 @C2 via c9;
broadcast R((-(pi/2)),0) q0@C2, R((-(pi/2)),0) q3@C2 via b2;
pulse R((-(pi/2)),(pi/2)) q0 @C2 via c11;
readout q0 -> c0 @C2 via a2;
readout q3 -> c1 @C2 via a2;
