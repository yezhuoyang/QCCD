# The relay the invitation mail goes out through, read by qccd-comments.service.
#
# Install it as /etc/qccd/mail.env, owned by root and readable by the qccd user only --
# it holds an app password:
#
#   install -d -m 755 /etc/qccd
#   install -o root -g qccd -m 640 mail.env.example /etc/qccd/mail.env
#   $EDITOR /etc/qccd/mail.env && systemctl restart qccd-comments
#
# Gmail: the account must have 2-step verification on; then make an app password at
# https://myaccount.google.com/apppasswords.  Google shows it as four groups of four --
# paste the sixteen characters below with the spaces taken out, because that is what the
# SMTP login is.  Gmail rewrites From: to the account's own address, so QCCD_MAIL_FROM is
# that address, not a qccd.academy one.
#
# Any other relay speaks the same four settings: Resend (smtp.resend.com:587, user
# "resend", the API key as the password), SendGrid (smtp.sendgrid.net:587, user
# "apikey"), Mailgun, Postmark.  Those let From: be an address at a domain you have
# added DNS records for, which lands in fewer spam folders than Gmail does.
#
# With this file absent or QCCD_SMTP_HOST empty, nothing is mailed: an invitation is
# still made, and the panel hands the admin the link to send by hand.

QCCD_SMTP_HOST=smtp.gmail.com
QCCD_SMTP_PORT=587
QCCD_SMTP_MODE=starttls
QCCD_SMTP_USER=someone@gmail.com
QCCD_SMTP_PASSWORD=abcdefghijklmnop
QCCD_MAIL_FROM=someone@gmail.com
QCCD_SITE_URL=https://qccd.academy
