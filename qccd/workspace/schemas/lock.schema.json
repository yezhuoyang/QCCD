{
 "$id": "https://qccd.academy/schemas/workspace/v1/lock.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "description": "Version 2: a general workspace (any design, any board).  Version 1, the old pinned form,\nalso names one task release (`mode`, `task`, `numerical_policy`); it still opens.",
 "properties": {
  "evaluator": {
   "additionalProperties": true,
   "title": "Evaluator",
   "type": "object"
  },
  "kind": {
   "const": "qccd.lock",
   "title": "Kind",
   "type": "string"
  },
  "mode": {
   "anyOf": [
    {
     "enum": [
      "task",
      "exploratory"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Mode"
  },
  "numerical_policy": {
   "anyOf": [
    {
     "additionalProperties": true,
     "type": "object"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Numerical Policy"
  },
  "schemas": {
   "additionalProperties": {
    "type": "string"
   },
   "title": "Schemas",
   "type": "object"
  },
  "task": {
   "anyOf": [
    {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Task"
  },
  "version": {
   "enum": [
    1,
    2
   ],
   "title": "Version",
   "type": "integer"
  },
  "workspace_id": {
   "title": "Workspace Id",
   "type": "string"
  }
 },
 "required": [
  "kind",
  "version",
  "workspace_id",
  "evaluator",
  "schemas"
 ],
 "title": "LockFile",
 "type": "object"
}
