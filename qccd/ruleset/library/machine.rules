# The machine's rules: a floorplan of verified places, and a logical program scheduled on it.
#
# One level up from the device rules.  The words -- places, roads, doors, carries, events,
# blocks, instructions, windows -- are defined on the Rules page, each with how it is read off
# the floorplan and off the schedule (docs/ARCHITECTURE.md §4-§5).  G1-G11 are the checks the
# place model has always made (docs/GADGETS.md §8-§10), now written as assertions.

ruleset "machine";
level "machine";
title "The machine's rules";
about "A floorplan of verified places joined by roads and wires, and a logical program scheduled on it: what every gadget-level schedule must respect, whatever runs in parallel.";

param coherence_budget = 1000000;

# ---------------------------------------------------------------- interface

assert G1 "Ports on a road agree, and every bundle arrives in the order its place takes it in" core
  about "A road or a wire joins two doors that carry the same thing (ions of the same role, width and code, or bits of the same signal) in opposite directions; a door that is not a free-for-all is on one road at most; and every bundle an op takes in arrives, in exactly the order the op's verified program takes it.":
  (forall r:roads, a:ends(r), b:ends(r) where a != b.
     medium(a) = medium(b)
     and (role(a) = role(b) or role(a) = "any" or role(b) = "any")
     and (role(a) != "data" or role(b) != "data" or
          (width(a) = width(b) and (code(a) = none or code(b) = none or code(a) = code(b))))
     and (dir(a) != dir(b) or dir(a) = "inout"))
  and (forall w:wires, a:ends(w), b:ends(w) where a != b.
     medium(a) = medium(b)
     and (signal(a) = signal(b) or signal(a) = "any" or signal(b) = "any")
     and (dir(a) != dir(b) or dir(a) = "inout"))
  and (forall d:doors where role(d) != "any".
     count(r:roads where d in ends(r)) <= 1)
  and (forall k:intakes.
     delivered_by(k) != none and delivered(k) = expected(k));

# ---------------------------------------------------------------- ownership and capacity

assert G2 "Every ion leaves only from where it is, and ends where it should" core
  about "Follow every ion through every handoff: it is loaded only if it did not exist, it leaves only the place it is in, it arrives only from the road it is on; every resident ion ends at home, and every loaded ion ends dumped at a depot or in a block still alive.":
  (forall h:handoffs. location(ion(h), before(h)) = origin(h))
  and (forall i:residents. location(i, final()) = home(i))
  and (forall i:loaded where i not in living. location(i, final()) in depots);

assert G3 "No place holds more ions than its capacity" core
  about "At every instant, counting an ion in a place from the moment it arrives until the moment it leaves, no place other than a depot holds more ions than it was built for, or gives away more than it has.":
  forall p:places, t:instants where family(p) != "depot".
    occupancy(p, t) <= capacity(p) and occupancy(p, t) >= 0;

assert G4 "A road holds at most its sites, and carries one way at a time" core
  about "No road ever holds more ions than it has sites, and no two bundles travel it in opposite directions at once.":
  (forall r:roads, t:instants. occupancy(r, t) <= capacity(r))
  and (forall c1, c2:carries where road(c1) = road(c2) and simultaneous(c1, c2).
     origin(c1) = origin(c2));

assert G5 "A place runs one op at a time" core
  about "Two ops of the same place, junctions and the classical places included, never overlap.":
  forall a, b:events where a != b and place(a) = place(b) and duration(a) > 0 and duration(b) > 0.
    not simultaneous(a, b);

assert G6 "No ion gets hotter than the ion-loss limit"
  about "Neither inside a place's op, nor crossing one of its doors, nor on its way between places does an ion's motional energy pass the limit beyond which it is likely to be lost. Its n-bar is followed through every op, road and junction: a road and a junction pass add what their replay charges, and an op is replayed from the n-bar its ions arrive at, so a bundle that crossed twenty junctions is as hot as it is."
  source "arXiv:1210.3655":
  forall e:events.
    exit_heat(e) <= ion_loss_limit() and peak_heat(e) <= ion_loss_limit();

# ---------------------------------------------------------------- composition

assert G7 "Every instruction is carried out, and each block's in program order" core
  about "No instruction is refused or left without an event, and an instruction that acts on a block's ions starts only after the previous instruction on that block has finished with them.":
  (forall i:instructions. not refused(i) and realised(i))
  and (forall i, j:instructions where next_on_block(i, j). begins(j) >= finishes(i));

assert G8 "No block waits longer than its coherence budget without syndrome extraction"
  about "Between ops that extract its syndromes, a block may wait or travel, but not for longer than the memory's coherence lets it.":
  forall b:blocks. longest_gap(b) <= coherence_budget;

assert G9 "Every op used is verified" core
  about "Every op the schedule runs at a place is verified as hardware and as logic (or certified); an op of the classical half is modeled, its latency a stated number.":
  forall e:events.
    (status(e) = "verified" or status(e) = "certified" or (classical(e) and status(e) = "modeled"))
    and not logic_failed(e);

# ---------------------------------------------------------------- the classical half

assert G10 "Every classical bit is used after it exists"
  about "A message crosses a wire the floorplan has, between that wire's doors, in that wire's latency; it leaves no earlier than the op that measured its bits began and, unless it is a syndrome a decode sent out of its readout buffer, no later than that op ended; something at its destination uses it after it arrives; and no line of the classical memory names a measurement that has not begun."
  when count(m:messages) > 0 or count(w:wires) > 0:
  (forall m:messages.
     wire(m) != none and connects(wire(m), m) and approx(duration(m), latency(wire(m))))
  and (forall m:messages where measured_by(m) != none. start(m) >= start(measured_by(m)))
  and (forall m:messages where measured_by(m) != none and not held(m) and not classical(origin(m)).
     start(m) <= end(measured_by(m)))
  and (forall m:messages.
     exists e:events where place(e) = destination(m) and instruction(e) = instruction(m).
       start(e) >= end(m))
  and (forall f:frame_rows, e:named(f). start(e) <= at(f))
  and (forall o:outcomes, e:named(o). start(e) <= at(o));

assert G11 "The decoder is called, and keeps up"
  about "Every syndrome the machine measures is sent to the decoder by a decode instruction, no earlier than it was measured; every decoding job starts after its syndrome arrives and before the next one does (or the decoder falls behind); a classically controlled op starts only once its guard is at its door; and nothing reads an outcome before the decoder has corrected it."
  when decoder_present() or count(e:guarded) > 0:
  (forall j:decode_jobs.
     syndrome_of(j) != none and start(j) >= end(syndrome_of(j))
     and (next_syndrome(j) = none or start(j) <= end(next_syndrome(j))))
  and (forall e:guarded.
     start(e) >= ready(e) and (exists m:decisions(e). end(m) <= start(e)))
  and (forall w:windows.
     decoded(w) and (exists m:sends(w). start(m) >= measured(w))
     and (forall m:sends(w). start(m) >= measured(w)))
  and (forall e:guarded, w:reads(e). ready(e) >= written(w))
  and (forall f:frame_rows, w:reads(f). at(f) >= written(w));

# ---------------------------------------------------------------- parallel execution

assert G12 "Every bundle that travels is taken in at the far end" core
  about "No ion is left on a road: every carry ends with the ops at its destination taking each of its ions in exactly once, in the order it travels -- one op for a whole bundle (a place's, a depot taking used ions back), or a junction's lone passes, one ion at a time, as the road delivers them.":
  forall c:carries. taken(c) = order(c);

assert G13 "A road carries one bundle at a time" core
  about "A road is leased to one bundle from the moment its first ion enters until its last is taken off the far end; two bundles never share a road at once, so neither can block or overtake the other, whatever runs in parallel.":
  forall c1, c2:carries where c1 != c2 and road(c1) = road(c2). not simultaneous(c1, c2);

assert G14 "A road holds the ions on it"
  about "At no moment are more of a bundle's ions on a road's sites than it has. By the road's own compiled program, an ion that has arrived waits on the far door's stub, which has room for the bundle, until it is taken in, so a short street between junctions holds only the few ions crossing it at once. Without the program, an ion counts as on the road from when it leaves until it is taken in.":
  forall c:carries. crowd(c) <= length(road(c));


# ---------------------------------------------------------------- the hardware between gadgets

assert H1 "The hardware between gadgets obeys the basic rules" core
  about "A gadget is a box with doors, but the chip is one: what carries ions between the boxes is driven by DACs and electrodes like what moves them inside one. Every carry, compiled with its whole bundle onto its road's own machine -- one class a cycle, a shift rigid, a blocked ion holding by its switch -- passes R1-R23; it delivers every ion before the far side takes it; and a door's stub is driven by one side at a time, the road never loading or delivering while the op there moves an ion on or off it.":
  forall c:carries. road_ok(c);

assert H2 "Machines that share a plane play one waveform at a time" core
  about "A floorplan may say that machines share one plane of DACs, or one laser, instead of driving their own. Then they are one set of channels: at no instant do two of them play different cycles -- each op's TSIR at its times, each road's compiled program -- unless it is the very same cycle (class, direction, start and end), played once for both. Members take turns; a trip over two roads of one plane waits between them.":
  plane_conflicts() = 0;