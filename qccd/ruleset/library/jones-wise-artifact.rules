# Opaque global reconfigurations captured from the artifact, without its formula.
ruleset "jones-wise-artifact"
title "Jones's recorded WISE artifact"
about "Jones's ordinary operations, plus recorded global permutations. Global durations are recorded, not checked; internal paths are not recorded."
include "jones"
param allow_reconfigure = true

rule R29 "Ordinary operations last what the clock says; global durations are recorded, not checked"
  about "Only the primitive operations have an independent clock law. Global permutation durations are recorded, not checked, even in strict mode."
  for all o in operations where kind(o) != "reconfigure" and clocked(o):
    approx(duration(o), clock(o))

rule A1 "A global reconfiguration holds the whole device"
  about "Every trap, rail and junction is held; no other operation may overlap, including operations on ions not in the recorded permutation."
  (for all a in operations where kind(a) = "reconfigure": holds_device(a) and duration(a) > 0)
  and (for all a, b in operations where a != b and kind(a) = "reconfigure":
       not simultaneous(a, b))
