  "load": {
   "capacity": 8,
   "gate": false,
   "spam": true,
   "cool": true,
   "photoionization": true
  }
 },
 "heating": {
  "anomalous_rate_quanta_per_ms": 0.029,
  "note": "R17: accrues whether or not the ion moves. 29(4) quanta/s, the axial centre-of-mass mode of a Ba-Yb crystal in Quantinuum's junction trap",
  "source": "arXiv:2206.11888 Fig. 3 caption"
 },
 "species": {
  "T_coh_s": 126.6,
  "coolant": "171Yb+",
  "coolant_fraction": 0.5,
  "note": "Helios pairs each 137Ba+ qubit with one 171Yb+ coolant. T_coh_s (derived) is 1/r for the Helios linear memory rate r = 7.9e-3/s, so the coarse idle estimate of qccd.cost.physical agrees with qccd-noise@2's memory channel",
  "qubit": "137Ba+",
  "source": "arXiv:2511.05465 Sec. II B",
  "sympathetic": true
 },
 "budget": {
  "junction_electrode_multiplier": 2,
  "max_area_mm2": 100,
  "max_dacs": 128,
  "max_junctions": 200
 },
 "control": {
  "model": "simd_classes",
  "classes": {
   "generator": "x_junction_grid",
   "count": 18,
   "note": "12 directional shifts + 6 directional swaps (JT-SIMD, 2504.17886)",
   "extra": [
    {
     "id": "shuttle",
     "type": "shift",
     "orbit": "any",
     "note": "one ion, one trap to the next; the lowest common denominator move"
    }
   ]
  },
  "max_simd_classes_per_cycle": 1,
  "intra_inter_exclusive": true,
  "wiring": {
   "scheme": "direct",
   "dacs_dynamic": 100,
   "shim_per_dac": 1,
   "electrodes_per_trap": 24,
   "electrodes_per_junction": 48,
   "compensation_electrodes_per_trap": 8
  },
