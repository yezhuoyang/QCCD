{
 "schema_version": "0.3",
 "provenance": {
  "baseline": "PLAN \u00a77.1 baseline 3 (2004.04706, static EJF scheduling)",
  "note": "2ab - a - b = 144 traps at a = b = 9, one per data qubit"
 },
